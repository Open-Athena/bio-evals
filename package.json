{
  "name": "bio-evals",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test --test-concurrency=1",
    "refresh": "node scripts/github.mjs",
    "prepare-site": "node scripts/generate.mjs",
    "build": "npm run validate && npm run prepare-site && observable build",
    "dev": "npm run prepare-site && observable preview --host 127.0.0.1"
  },
  "dependencies": {
    "@observablehq/framework": "1.13.4",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
